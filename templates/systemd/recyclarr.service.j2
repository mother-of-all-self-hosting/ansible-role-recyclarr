[Unit]
Description=Recyclarr ({{ recyclarr_identifier }})
{% for service in recyclarr_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in recyclarr_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ recyclarr_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ recyclarr_identifier }} \
      --log-driver=none \
      --user={{ recyclarr_uid }}:{{ recyclarr_gid }} \
      --cap-drop=ALL \
      --read-only \
      --network={{ recyclarr_container_network }} \
      --env-file={{ recyclarr_base_path }}/env \
      --mount type=bind,src={{ recyclarr_data_path }},dst=/config \
      --mount type=bind,src={{ recyclarr_base_path }}/recyclarr.yml,dst=/config/recyclarr.yml,readonly \
      {% for volume in recyclarr_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ recyclarr_container_tmpfs_tmp_size }} \
      {% for arg in recyclarr_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ recyclarr_container_image }}

{% for network in recyclarr_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ recyclarr_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ recyclarr_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ recyclarr_container_stop_grace_time_seconds }} {{ recyclarr_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ recyclarr_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ recyclarr_identifier }}

[Install]
WantedBy=multi-user.target
